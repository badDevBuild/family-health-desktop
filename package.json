{
  "name": "family-health-desktop",
  "version": "0.1.0",
  "description": "温暖、可信、可追溯的本地家庭健康桌面看板",
  "author": "Family Health Desktop Contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "runtime:stage": "node scripts/stage-sqlite-runtime.mjs && node scripts/stage-codex-runtime.mjs",
    "build:unpack": "pnpm runtime:stage && pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "package:mac:arm64": "node scripts/stage-sqlite-runtime.mjs --target=darwin-arm64 && node scripts/stage-codex-runtime.mjs --target=darwin-arm64 && pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "package:mac:x64": "node scripts/stage-sqlite-runtime.mjs --target=darwin-x64 && node scripts/stage-codex-runtime.mjs --target=darwin-x64 && pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "package:win:x64": "node scripts/stage-sqlite-runtime.mjs --target=win32-x64 && node scripts/stage-codex-runtime.mjs --target=win32-x64 && pnpm build && electron-builder --win --x64",
    "native:node": "pnpm rebuild better-sqlite3",
    "native:electron": "electron-builder install-app-deps",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "pretest": "pnpm native:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:build",
    "verify:build": "node scripts/verify-built-app.mjs",
    "protocol:generate": "node scripts/generate-codex-schema.mjs",
    "runtime:probe": "tsx scripts/probe-codex-runtime.ts",
    "runtime:probe:libreoffice": "tsx scripts/probe-libreoffice-runtime.ts",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "benchmark:local": "vitest run --config vitest.benchmark.config.ts",
    "gold:materialize": "node --experimental-strip-types scripts/materialize-synthetic-gold.ts",
    "scan:release": "node scripts/scan-release-artifact.mjs",
    "scan:public": "node scripts/scan-public-repository.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "file-type": "^21.0.0",
    "iconv-lite": "^0.7.0",
    "jszip": "3.10.2",
    "libheif-js": "1.19.8",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "word-extractor": "1.0.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@openai/codex": "0.145.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.20",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
